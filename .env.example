# ==============================================================================
# SERVER & HOSTINGER DEPLOYMENT CONFIGURATION
# ==============================================================================

# NODE_ENV: Set to "production" on Hostinger ("development" locally).
NODE_ENV="production"

# PORT: HTTP port the Express server binds to.
# Hostinger hPanel Node.js Web Apps inject process.env.PORT automatically; on a Hostinger VPS, 3000 is standard behind Nginx.
PORT="3000"

# HOST: Network interface to bind to ("0.0.0.0" required for Hostinger hPanel containers, Docker, and cloud reverse proxies).
HOST="0.0.0.0"

# DATA_DIR: Persistent filesystem directory for the SQLite database (gallery.sqlite) and uploaded thumbnails (/uploads).
# CRITICAL FOR GITHUB REDEPLOYS: Set DATA_DIR to an absolute path OUTSIDE your Git checkout directory
# (for example "/var/lib/nocturne-vault/data" on a Hostinger VPS or a persistent path outside the release folder)
# so automated GitHub redeployments never overwrite or wipe live videos, settings, or uploaded thumbnails.
DATA_DIR="./data"

# TRUST_PROXY: Reverse-proxy hop count for accurate client IP rate-limiting and Secure admin cookies behind
# Hostinger LiteSpeed/Nginx SSL termination, Cloudflare, Render, or Railway. Defaults to "1" in production.
TRUST_PROXY="1"

# ==============================================================================
# ADMIN SECURITY & ADSTERRA VERIFICATION (SERVER-SIDE SECRETS — NEVER COMMIT)
# ==============================================================================

# INITIAL_ADMIN_PIN: Initial setup PIN used ONLY when creating a brand-new empty database (defaults to 20055 if unset).
# Stored as a salted PBKDF2-HMAC-SHA512 hash; never overwrites an existing admin PIN. Rotate immediately in Admin -> Admin Security.
INITIAL_ADMIN_PIN=""

# ADSTERRA_POSTBACK_SECRET: Optional shared secret token used only if "Server-Verified Postback Callback" unlock mode is enabled.
# Postback endpoint (depends on your live Hostinger domain):
# https://<your-hostinger-domain>/api/public/adsterra/postback?subid={SUBID}&secret=<ADSTERRA_POSTBACK_SECRET>
ADSTERRA_POSTBACK_SECRET=""

# ==============================================================================
# DOMAIN, CORS & OPTIONAL SPLIT/GATEWAY HOSTING CONFIGURATION
# ==============================================================================

# APP_URL: Public HTTPS URL of your live Hostinger domain (depends on your assigned domain, e.g. "https://yourdomain.com").
APP_URL="https://your-domain.example"

# VITE_API_BASE_URL: Leave empty ("") when deploying full-stack Node.js on Hostinger (same-origin /api and /uploads — recommended).
# Only set (e.g. "https://api.yourdomain.com") if hosting static dist/ separately from the Node.js backend.
VITE_API_BASE_URL=""

# CORS_ORIGIN: Leave empty ("") for standard single-domain Hostinger deployments.
# If frontend and API run on separate origins, list explicit comma-separated https:// origins (wildcard "*" is rejected for security).
CORS_ORIGIN=""

# BACKEND_URL: Used ONLY when deploying the frontend on Vercel or Netlify via the built-in serverless gateway.
# Leave empty ("") on Hostinger.
BACKEND_URL=""

# ==============================================================================
# PLATFORM RUNTIME PLACEHOLDERS
# ==============================================================================

# GEMINI_API_KEY: Placeholder preserved for Google AI Studio runtime compatibility (not required by gallery features).
GEMINI_API_KEY="MY_GEMINI_API_KEY"


